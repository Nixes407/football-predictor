# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# On a hosted backend (Render / Railway / Fly) set these as service
# environment variables instead — `load_dotenv()` never overrides a variable
# that is already present in the real environment.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string (SQLAlchemy / psycopg2)
DATABASE_URL=postgresql://user:password@localhost:5432/football_predictor

# football-data.org key for fixtures/results and Brazilian match history.
# GitHub Actions needs the same-named secret configured separately.
FOOTBALL_DATA_API_KEY=

# ---------------------------------------------------------------------------
# CORS — required for the deployed frontend to reach this API
# ---------------------------------------------------------------------------
# The browser calls this API directly, so every origin that may load the
# frontend has to be listed here. Use full origins: scheme + host, no path and
# no trailing slash.

# Comma-separated allowlist of browser origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# Single-origin shortcut, merged into the list above (either variable alone
# works; both together is fine).
FRONTEND_URL=https://your-frontend.vercel.app

# Optional. A regex for origins that cannot be enumerated one by one, e.g.
# Vercel preview deployments on a new subdomain per pull request. Leave unset
# in production if you would rather keep the allowlist explicit.
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# ---------------------------------------------------------------------------
# Supabase Storage (pre-built model artifacts)
# ---------------------------------------------------------------------------
# The daily GitHub Actions workflow trains the models and uploads every
# .joblib file plus features.csv to the "models" bucket. On startup the API
# downloads them again (a lightweight reload — it never trains anything).
#
# SUPABASE_SERVICE_ROLE_KEY is the preferred name. SUPABASE_KEY is still
# accepted as a legacy fallback (that is the variable the Render service uses).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Pipeline trigger
# ---------------------------------------------------------------------------
# Shared secret for POST /predict/admin/reload-models (the GitHub Actions
# workflow calls it after uploading new artifacts). The endpoint returns 403
# unless the request supplies this value, so leaving it empty disables it.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
PIPELINE_SECRET=
