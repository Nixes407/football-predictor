# Example environment file for the DEPLOYED frontend (e.g. Vercel).
# Copy to `.env.production`, or set the same variable in the Vercel dashboard:
#   Project → Settings → Environment Variables → NEXT_PUBLIC_API_URL
#
# `.env` / `.env.local` are git-ignored; this example file is committed.
#
# Origin of the deployed FastAPI backend, with no trailing slash. The frontend
# calls it directly from the browser, so the backend must allow this site's
# origin through CORS (see backend/.env.example).

NEXT_PUBLIC_API_URL=https://football-predictor-kyk5.onrender.com
